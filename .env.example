# ==============================================================================
# PersonalWebsite Environment Configuration Template
# Copy this file to .env and fill in the values for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# GitHub Actions Runner Controller (ARC) Credentials (infra/arc-setup.sh)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

# ------------------------------------------------------------------------------
# AWS & Terraform Backend Configuration (infra/aws-setup.sh & terraform/)
# ------------------------------------------------------------------------------
AWS_PROFILE=personal-site
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_PARTITION=aws
TF_STATE_BUCKET=
AWS_ROLE_NAME=personal-site-github-actions-terraform
AWS_POLICY_NAME=personal-site-terraform-deployer-policy
GITHUB_REPO=josephaw1022/PersonalWebsite

# ------------------------------------------------------------------------------
# Cloudflare Zero Trust Tunnel & DNS Configuration
# ------------------------------------------------------------------------------
DOMAIN_NAME=jwhiteaker22.com
CLOUDFLARE_ACCOUNT_ID= # or CF_ACCOUNT_ID
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN= # or CF_API_TOKEN

# ------------------------------------------------------------------------------
# Uptime Monitoring & Downtime Alerts (Datadog Synthetics)
# ------------------------------------------------------------------------------
ALERT_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# Datadog AWS Account & ECS Agent Integration
# ------------------------------------------------------------------------------
DATADOG_SITE=us5.datadoghq.com # or DD_SITE
DATADOG_API_KEY= # or DD_API_KEY
DATADOG_APP_KEY= # or DD_APP_KEY
DATADOG_ACCESS_TOKEN= # or DD_ACCESS_TOKEN

