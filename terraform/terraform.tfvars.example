aws_region            = "us-east-1"
aws_account_id        = "123456789012"
aws_partition         = "aws"
project_name          = "personal-site"
ghcr_image            = "ghcr.io/josephaw1022/personalwebsite"
ghcr_image_tag        = "latest"

# AWS Resource Default Tags (optional overrides; defaults to datadog_env, project_name, and ghcr_image_tag)
# env                   = "prod"
# service               = "personal-site"
# app_version           = "latest"
cloudflare_account_id = "your-cloudflare-account-id"
cloudflare_zone_id    = "your-cloudflare-zone-id"
cloudflare_api_token  = "your-cloudflare-api-token"
domain_name           = "jwhiteaker22.com"
create_www_record     = true

# Datadog Synthetics Health Check & Alerts
alert_email = "you@example.com"

# Datadog AWS Account & ECS Fargate Agent Integration
datadog_site    = "us5.datadoghq.com"
datadog_api_key = "your-datadog-api-key"
datadog_app_key = "your-datadog-app-key"

# ECS Service Autoscaling (defaults: min 1, max 5)
# min_capacity                  = 1
# max_capacity                  = 5
# autoscaling_cpu_target        = 70.0
# autoscaling_memory_target     = 80.0
# autoscaling_scale_out_cooldown = 60
# autoscaling_scale_in_cooldown  = 300


