{
  "enforce-taskfile": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/enforce-taskfile.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "format-repo": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
